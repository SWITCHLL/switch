// SWITCH Platform — Prisma Schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ORGANIZER
  ADMIN
}

enum OrganizerStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum SeatingType {
  GENERAL_ADMISSION
  RESERVED
  MIXED
}

enum SeatMapStatus {
  ACTIVE
  ARCHIVED
}

enum SectionType {
  RESERVED
  GENERAL_ADMISSION
}

enum SeatType {
  STANDARD
  VIP
  VVIP
  ACCESSIBLE
  COMPANION
  PREMIUM
}

enum EventSeatStatus {
  AVAILABLE
  HELD
  RESERVED
  SOLD
  BLOCKED
}

enum TicketTypeStatus {
  ACTIVE
  INACTIVE
  SOLD_OUT
}

enum ReservationStatus {
  ACTIVE
  EXPIRED
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum RefundStatus {
  OPEN
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum GroupOrderStatus {
  PENDING   // waiting for all members to pay
  COMPLETE  // all slots paid
  EXPIRED   // deadline passed; partial/full release triggered
  CANCELLED // initiator cancelled before any slot was paid
}

enum GroupSlotStatus {
  OPEN     // unclaimed — any invited member can take it
  HELD     // member claimed it, payment in progress
  PAID     // payment complete, ticket issued
  RELEASED // member dropped out or slot expired unpaid
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum WaitlistStatus {
  PENDING
  OFFERED
  FULFILLED
  EXPIRED
  CANCELLED
}

enum SessionInclusionMode {
  INCLUDED
  OPTIONAL_FREE
  OPTIONAL_PAID
  CAPACITY_LIMITED
}

enum TicketVisibility {
  PUBLIC
  HIDDEN
  PASSWORD_PROTECTED
}

enum AuditEntityType {
  RESERVATION
  TICKET
  WAITLIST_ENTRY
  EVENT_SEAT
}

enum AuditAction {
  CREATED
  STATUS_CHANGED
  CANCELLED
  REFUNDED
  ISSUED
  EXPIRED
  OFFERED
  FULFILLED
}

// ─── User & Auth ──────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  organizer     Organizer?
  reservations  Reservation[]
  tickets       Ticket[]
  orders        Order[]
  organizerApplication OrganizerApplication?
  payments      Payment[]
  reviews       EventReview[]
  refundRequests RefundRequest[]
  initiatedGroups GroupOrder[]       @relation("GroupOrderInitiator")
  claimedSlots    GroupOrderSlot[]   @relation("GroupSlotClaimer")
  calendars       UserCalendar[]
  sharedCalendars CalendarShare[]    @relation("CalendarSharedWith")
  waitlistEntries WaitlistEntry[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Organizer ────────────────────────────────────────────────────────────────

model Organizer {
  id          String          @id @default(cuid())
  userId      String          @unique
  name        String
  slug        String          @unique
  bio         String?         @db.Text
  logoUrl     String?
  websiteUrl  String?
  status      OrganizerStatus @default(PENDING)
  /// Custom platform fee % for partner organizers. Null = use env default.
  feePercent        Float?
  /// Paystack bank details for payouts
  bankCode          String?
  bankAccountNumber String?
  bankAccountName   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]
  payoutRequests PayoutRequest[]
  payments       Payment[]
  promoCodes     PromoCode[]

  @@map("organizers")
}

// ─── Organizer Application (KYC) ─────────────────────────────────────────────

model OrganizerApplication {
  id     String    @id @default(cuid())
  userId String    @unique

  /// Public display name for the organizer page
  organizerName String
  /// Short bio / description
  bio           String?  @db.Text

  // ── Identity verification ─────────────────────────────────────────────────
  /// National Identification Number
  nin    String

  /// Means of ID type submitted (e.g. "NATIONAL_ID", "DRIVERS_LICENSE", "INTL_PASSPORT", "VOTERS_CARD")
  idType    String
  /// CDN / storage URL of the uploaded ID document
  idDocUrl  String

  // ── Social handles (all optional) ────────────────────────────────────────
  instagramUrl String?
  twitterUrl   String?
  facebookUrl  String?
  websiteUrl   String?

  // ── Review ────────────────────────────────────────────────────────────────
  kycStatus      KycStatus @default(PENDING)
  /// Admin note — rejection reason or approval note
  reviewNote     String?   @db.Text
  reviewedAt     DateTime?
  /// Admin user who reviewed this application
  reviewedBy     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([kycStatus])
  @@map("organizer_applications")
}

// ─── Category ─────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  /// CDN image URL for the category icon/banner
  imageUrl  String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]

  @@map("categories")
}

// ─── Venue ────────────────────────────────────────────────────────────────────

model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String?
  city      String
  state     String?
  country   String
  /// Maximum physical capacity of the venue
  capacity  Int?
  /// CDN image URL
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seatMaps SeatMap[]
  events   Event[]

  @@map("venues")
}

// ─── Seat Map ─────────────────────────────────────────────────────────────────

model SeatMap {
  id      String        @id @default(cuid())
  venueId String
  name    String
  /// Incremented when the layout changes — existing events keep their snapshot
  version Int           @default(1)
  /// Logical canvas dimensions (px) for the visual builder
  width   Float?
  height  Float?
  status  SeatMapStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venue    Venue     @relation(fields: [venueId], references: [id])
  sections Section[]
  events   Event[]

  @@index([venueId])
  @@map("seat_maps")
}

// ─── Section ──────────────────────────────────────────────────────────────────

model Section {
  id        String      @id @default(cuid())
  seatMapId String
  name      String
  /// Short uppercase code, e.g. "VIP", "REG", "STANDING"
  code      String
  type      SectionType @default(RESERVED)
  capacity  Int?
  /// Visual builder coordinates
  positionX Float?
  positionY Float?
  width     Float?
  height    Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seatMap SeatMap @relation(fields: [seatMapId], references: [id])
  rows    Row[]

  @@index([seatMapId])
  @@map("sections")
}

// ─── Row ──────────────────────────────────────────────────────────────────────

model Row {
  id        String  @id @default(cuid())
  sectionId String
  /// Display label: "A", "B", "101", etc.
  label     String
  /// Ordering within the section
  position  Int?
  seatsCount Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section Section @relation(fields: [sectionId], references: [id])
  seats   Seat[]

  /// Label must be unique within a section
  @@unique([sectionId, label])
  @@map("rows")
}

// ─── Seat ─────────────────────────────────────────────────────────────────────

model Seat {
  id        String   @id @default(cuid())
  rowId     String
  sectionId String
  /// Display label: "A12", "B4", etc.
  label     String
  /// Numeric seat number within the row
  number    Int?
  type      SeatType @default(STANDARD)
  /// Visual builder coordinates
  positionX Float?
  positionY Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  row        Row         @relation(fields: [rowId], references: [id])
  eventSeats EventSeat[]

  /// Label must be unique within a row
  @@unique([rowId, label])
  @@index([sectionId])
  @@map("seats")
}

// ─── Event ────────────────────────────────────────────────────────────────────

model Event {
  id          String      @id @default(cuid())
  organizerId String
  venueId     String?
  seatMapId   String?
  categoryId  String?

  title       String
  slug        String      @unique
  description String?     @db.Text
  /// CDN image URL for the event banner/poster
  imageUrl    String?

  seatingType SeatingType @default(GENERAL_ADMISSION)
  status      EventStatus @default(DRAFT)

  /// true = all ticket types are free (price = 0)
  isFree      Boolean     @default(false)
  /// true = event is online-only; false = physical venue
  isVirtual   Boolean     @default(false)
  /// Stream/meeting URL — only set when isVirtual = true
  virtualLink String?

  /// Venue details stored inline — no FK to venues table needed for now
  venueName    String?
  venueAddress String?
  venueCity    String?
  venueState   String?

  startsAt    DateTime
  endsAt      DateTime?
  /// When tickets go on sale
  salesStart  DateTime?
  /// When ticket sales close
  salesEnd    DateTime?

  /// Total capacity override (for GA events; reserved events use seat inventory)
  capacity    Int?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organizer   Organizer    @relation(fields: [organizerId], references: [id])
  venue       Venue?       @relation(fields: [venueId], references: [id])
  seatMap     SeatMap?     @relation(fields: [seatMapId], references: [id])
  category    Category?    @relation(fields: [categoryId], references: [id])
  ticketTypes TicketType[]
  eventSeats  EventSeat[]  @relation("EventToEventSeats")
  reservations Reservation[]
  tickets     Ticket[]
  orders      Order[]
  images      EventImage[]
  speakers    EventSpeaker[]
  payments    Payment[]
  payoutRequests PayoutRequest[]
  reviews     EventReview[]
  refundRequests RefundRequest[]
  groupOrders  GroupOrder[]
  promoCodes   PromoCode[]
  calendarEvents CalendarEvent[] @relation("CalendarLinkedEvent")
  scheduleItems   EventScheduleItem[]
  timeSlots       TimeSlot[]
  sessions        EventSession[]
  waitlistEntries WaitlistEntry[]
  @@index([status, startsAt])
  @@index([organizerId])
  @@index([categoryId])
  @@map("events")
}

// ─── Event Speaker / Guest / Performer ───────────────────────────────────────

model EventSpeaker {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  /// e.g. "Speaker", "Performer", "Guest", "Host", "DJ", etc.
  role      String?
  avatarUrl String?
  /// Display order
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scheduleItems  EventScheduleItem[]

  @@index([eventId, position])
  @@map("event_speakers")
}

// ─── Event Schedule Item ──────────────────────────────────────────────────────

model EventScheduleItem {
  id          String   @id @default(cuid())
  eventId     String
  /// e.g. "Opening Prayer", "Keynote Address", "Lunch Break"
  title       String
  /// Optional extra detail shown on the programme
  description String?  @db.Text
  /// Free-text name of the host/lead for this item
  hostName    String?
  /// Optional FK to an EventSpeaker already added to this event
  speakerId   String?
  startsAt    DateTime?
  endsAt      DateTime?
  /// Display order within the programme
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker EventSpeaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)

  @@index([eventId, position])
  @@map("event_schedule_items")
}


model EventImage {
  id        String   @id @default(cuid())
  eventId   String
  /// Public CDN/Supabase Storage URL
  url       String
  /// Display order — 0 = primary banner
  position  Int      @default(0)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, position])
  @@map("event_images")
}

// ─── Ticket Type ──────────────────────────────────────────────────────────────

model TicketType {
  id          String           @id @default(cuid())
  eventId     String
  name        String
  description String?
  /// Price in minor currency units (kobo for NGN, cents for USD)
  price       Int
  currency    String           @default("NGN")
  /// Total available quantity; null = unlimited
  quantity    Int?
  /// Number sold — derived, kept in sync on purchase
  sold        Int              @default(0)
  salesStart  DateTime?
  salesEnd    DateTime?
  status      TicketTypeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Purchase limits
  minPerOrder  Int?
  maxPerOrder  Int?
  maxPerUser   Int?

  // Visibility control
  visibility         TicketVisibility @default(PUBLIC)
  /// bcrypt hash of the access password (only set when visibility = PASSWORD_PROTECTED)
  accessPasswordHash String?
  /// Opaque token for direct-link unlock (only set when visibility = HIDDEN)
  directLinkToken    String?          @unique

  // Table reservation metadata
  isTableType             Boolean @default(false)
  tableCapacity           Int?
  requiresAssignedSeating Boolean @default(false)

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventSeats EventSeat[]
  tickets    Ticket[]
  groupSlots GroupOrderSlot[]
  promoCodes PromoCode[]
  waitlistEntries  WaitlistEntry[]
  tableAssignments TableSeatAssignment[]
  timeSlotCapacities TimeSlotCapacity[]
  timeSlotTickets    TimeSlotTicket[]

  @@index([eventId])
  @@map("ticket_types")
}

// ─── Event Seat (inventory) ───────────────────────────────────────────────────

model EventSeat {
  id            String          @id @default(cuid())
  eventId       String
  seatId        String
  ticketTypeId  String?
  /// Price in minor units for this specific seat/event combination
  price         Int
  status        EventSeatStatus @default(AVAILABLE)
  /// Redis lock expiry mirrors this for consistency
  lockedUntil   DateTime?
  /// FK to the reservation currently holding this seat (nullable)
  reservationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations — Event is the owning side via eventId scalar
  event       Event        @relation("EventToEventSeats", fields: [eventId], references: [id], onDelete: Cascade)
  seat        Seat         @relation(fields: [seatId], references: [id])
  ticketType  TicketType?  @relation(fields: [ticketTypeId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id])
  // Back-relation to Ticket — Ticket owns the FK
  tickets     Ticket[]
  groupSlots  GroupOrderSlot[]

  /// One EventSeat record per seat per event
  @@unique([eventId, seatId])
  @@index([eventId, status])
  @@map("event_seats")
}

// ─── Reservation ─────────────────────────────────────────────────────────────

model Reservation {
  id        String            @id @default(cuid())
  eventId   String
  userId    String
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime

  /// GA quantity holds: { ticketTypeId: quantity }
  gaHolds         Json?
  /// FK to waitlist entry that triggered this reservation (nullable)
  waitlistEntryId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event         Event          @relation(fields: [eventId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  eventSeats    EventSeat[]
  waitlistEntry WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id])
  order         Order?

  @@index([eventId, status])
  @@index([userId])
  @@map("reservations")
}

// ─── Ticket ───────────────────────────────────────────────────────────────────

model Ticket {
  id           String       @id @default(cuid())
  eventId      String
  userId       String
  /// FK to the Order this ticket belongs to (null for legacy/RSVP tickets without an Order)
  orderId      String?
  /// Null for general admission tickets
  eventSeatId  String?      @unique
  ticketTypeId String
  /// Human-readable: SWT-2026-8F92A1
  ticketNumber String       @unique
  /// Secure opaque token encoded in the QR code
  qrCode       String       @unique
  status       TicketStatus @default(ACTIVE)
  issuedAt     DateTime     @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event      @relation(fields: [eventId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  order      Order?     @relation(fields: [orderId], references: [id])
  /// Ticket owns the FK — EventSeat.ticket is the virtual back-relation
  eventSeat  EventSeat? @relation(fields: [eventSeatId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])
  review     EventReview?
  groupSlot  GroupOrderSlot?
  isComplimentary   Boolean            @default(false)
  sessionEnrolments SessionEnrolment[]
  timeSlotTickets   TimeSlotTicket[]
  tableAssignments  TableSeatAssignment[]

  @@index([eventId])
  @@index([userId])
  @@index([orderId])
  @@map("tickets")
}

// ─── Order ────────────────────────────────────────────────────────────────────

/// An Order groups all tickets purchased in a single checkout session.
/// One Order → one Paystack charge → one Payment → many Tickets.
model Order {
  id            String      @id @default(cuid())
  userId        String
  eventId       String
  /// FK to the Reservation that was active during checkout (nullable for RSVP)
  reservationId String?     @unique
  /// Total amount charged in minor units (kobo) — after discount
  totalAmount   Int
  currency      String      @default("NGN")
  /// Discount applied from a promo code (0 if none)
  discountAmount Int        @default(0)
  /// FK to the promo code used (nullable)
  promoCodeId   String?

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id])
  event         Event       @relation(fields: [eventId], references: [id])
  reservation   Reservation? @relation(fields: [reservationId], references: [id])
  promoCode     PromoCode?  @relation(fields: [promoCodeId], references: [id])
  payment       Payment?
  tickets       Ticket[]

  @@index([userId])
  @@index([eventId])
  @@map("orders")
}

// ─── Payment ──────────────────────────────────────────────────────────────────

model Payment {
  id              String        @id @default(cuid())
  /// FK to the Order this payment covers — replaces the old ticketId 1:1 relation
  orderId         String        @unique
  organizerId     String
  userId          String
  eventId         String

  /// Total amount user paid in minor units (kobo) — matches Order.totalAmount
  amount          Int
  currency        String        @default("NGN")
  /// Platform fee % snapshotted at purchase time
  platformFeePercent Float
  /// Platform fee amount in minor units (calculated on total amount)
  platformFeeAmount  Int
  /// Net amount organizer will receive (amount - platformFeeAmount)
  netAmount          Int

  status          PaymentStatus @default(PENDING)
  /// Paystack payment reference
  paystackReference String?     @unique
  /// Paystack transaction id
  paystackTransactionId String?

  /// FK to the payout request this payment is included in (set when payout is approved)
  payoutRequestId String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order           Order         @relation(fields: [orderId], references: [id])
  organizer       Organizer     @relation(fields: [organizerId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  event           Event         @relation(fields: [eventId], references: [id])
  payoutRequest   PayoutRequest? @relation("PaymentToPayoutRequest", fields: [payoutRequestId], references: [id])
  refundRequest   RefundRequest?
  groupSlot       GroupOrderSlot?

  @@index([organizerId])
  @@index([eventId])
  @@index([userId])
  @@map("payments")
}

// ─── Payout Request ───────────────────────────────────────────────────────────

model PayoutRequest {
  id              String       @id @default(cuid())
  organizerId     String
  eventId         String
  /// Total gross collected for this event (sum of payment.amount)
  grossAmount     Int
  /// Total platform fees deducted
  totalFees       Int
  /// Net amount to be paid out
  netAmount       Int
  currency        String       @default("NGN")

  status          PayoutStatus @default(PENDING)
  /// Admin who approved/rejected
  reviewedBy      String?
  reviewNote      String?      @db.Text
  reviewedAt      DateTime?

  /// Paystack Transfer code (set when transfer is initiated)
  paystackTransferCode String?
  /// Paystack recipient code for the organizer's bank
  paystackRecipientCode String?
  completedAt     DateTime?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organizer       Organizer    @relation(fields: [organizerId], references: [id])
  event           Event        @relation(fields: [eventId], references: [id])
  payments        Payment[]    @relation("PaymentToPayoutRequest")

  @@unique([organizerId, eventId])
  @@index([organizerId])
  @@index([status])
  @@map("payout_requests")
}

// ─── Event Review ─────────────────────────────────────────────────────────────

model EventReview {
  id          String   @id @default(cuid())
  eventId     String
  userId      String
  ticketId    String   @unique
  /// 1–5 stars
  rating      Int
  body        String?  @db.Text
  /// Organizer public reply
  reply       String?  @db.Text
  replyAt     DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event       Event    @relation(fields: [eventId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
  ticket      Ticket   @relation(fields: [ticketId], references: [id])

  @@index([eventId])
  @@index([userId])
  @@map("event_reviews")
}

// ─── Refund Request ───────────────────────────────────────────────────────────

model RefundRequest {
  id          String       @id @default(cuid())
  /// FK to the Payment (via Order) — kept for backward compat
  paymentId   String       @unique
  userId      String
  eventId     String
  /// User's reason for the complaint/refund
  reason      String       @db.Text

  status      RefundStatus @default(OPEN)
  /// Admin decision note
  reviewNote  String?      @db.Text
  reviewedBy  String?
  reviewedAt  DateTime?
  /// Paystack refund id (set when refund is processed)
  paystackRefundId String?
  /// For partial refunds: which specific ticket is being refunded
  ticketId    String?

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  payment     Payment      @relation(fields: [paymentId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  event       Event        @relation(fields: [eventId], references: [id])

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@map("refund_requests")
}

// ─── Group Order ──────────────────────────────────────────────────────────────

model GroupOrder {
  id          String           @id @default(cuid())
  eventId     String
  initiatorId String
  /// Short shareable code, e.g. "GRP-8F3A2C"
  code        String           @unique
  status      GroupOrderStatus @default(PENDING)
  /// All-or-nothing: if true the order auto-cancels when it expires with unpaid slots.
  /// If false, paid slots become confirmed and unpaid slots are released.
  requireFullPayment Boolean  @default(false)
  /// Hard deadline — BullMQ fires expiry job at this time
  expiresAt   DateTime

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  event     Event            @relation(fields: [eventId], references: [id])
  initiator User             @relation("GroupOrderInitiator", fields: [initiatorId], references: [id])
  slots     GroupOrderSlot[]

  @@index([eventId, status])
  @@index([initiatorId])
  @@map("group_orders")
}

// ─── Group Order Slot ─────────────────────────────────────────────────────────

model GroupOrderSlot {
  id           String          @id @default(cuid())
  groupOrderId String
  /// For RESERVED events: the specific EventSeat being held
  eventSeatId  String?
  /// For GA events: the ticket type the member will purchase
  ticketTypeId String?
  /// Price in minor units (kobo) — snapshotted at group creation
  price        Int
  currency     String          @default("NGN")
  /// Optional label the initiator sets — e.g. "John's seat"
  label        String?

  status       GroupSlotStatus @default(OPEN)
  /// User who claimed this slot (null = unclaimed)
  claimedBy    String?
  claimedAt    DateTime?
  /// Set when member completes payment
  paymentId    String?         @unique
  /// Set when ticket is issued after payment
  ticketId     String?         @unique

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  groupOrder   GroupOrder  @relation(fields: [groupOrderId], references: [id], onDelete: Cascade)
  eventSeat    EventSeat?  @relation(fields: [eventSeatId], references: [id])
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id])
  claimer      User?       @relation("GroupSlotClaimer", fields: [claimedBy], references: [id])
  payment      Payment?    @relation(fields: [paymentId], references: [id])
  ticket       Ticket?     @relation(fields: [ticketId], references: [id])

  @@index([groupOrderId, status])
  @@map("group_order_slots")
}

// ─── User Calendar ────────────────────────────────────────────────────────────

model UserCalendar {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?  @db.Text
  /// Hex color for display, e.g. "#7c3aed"
  color       String   @default("#7c3aed")
  /// Opaque token used for public share links / ICS export
  shareToken  String   @unique @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      CalendarEvent[]
  shares      CalendarShare[]

  @@index([userId])
  @@map("user_calendars")
}

model CalendarEvent {
  id           String    @id @default(cuid())
  calendarId   String
  title        String
  description  String?   @db.Text
  location     String?
  startsAt     DateTime
  endsAt       DateTime?
  /// true = all-day event (time portion is ignored in display)
  allDay       Boolean   @default(false)
  /// Optional link to a SWITCH platform Event
  linkedEventId String?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  calendar     UserCalendar  @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  linkedEvent  Event?        @relation("CalendarLinkedEvent", fields: [linkedEventId], references: [id], onDelete: SetNull)

  @@index([calendarId, startsAt])
  @@map("calendar_events")
}

model CalendarShare {
  id           String   @id @default(cuid())
  calendarId   String
  /// The user this calendar is shared with
  sharedWithId String
  /// Whether the recipient can add events to their own calendar from this share
  canCopy      Boolean  @default(true)
  createdAt    DateTime @default(now())

  calendar     UserCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  sharedWith   User         @relation("CalendarSharedWith", fields: [sharedWithId], references: [id], onDelete: Cascade)

  @@unique([calendarId, sharedWithId])
  @@index([sharedWithId])
  @@map("calendar_shares")
}

// ─── Promo Code ───────────────────────────────────────────────────────────────

model PromoCode {
  id           String       @id @default(cuid())
  organizerId  String
  /// null = applies to all events by this organizer
  eventId      String?
  /// null = applies to all ticket types on the scoped event
  ticketTypeId String?

  /// Human-readable code, e.g. "EARLYBIRD20" — stored uppercase
  code         String       @unique
  discountType DiscountType
  /// Percentage (1–100) or flat amount in minor units (kobo)
  discountValue Int
  /// null = unlimited uses
  maxUses      Int?
  /// How many times this code has been successfully used
  usedCount    Int          @default(0)
  /// null = never expires
  expiresAt    DateTime?
  isActive     Boolean      @default(true)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  organizer    Organizer    @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType   TicketType?  @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  orders       Order[]

  @@index([code])
  @@index([organizerId])
  @@index([eventId])
  @@map("promo_codes")
}

// ─── Waitlist Entry ───────────────────────────────────────────────────────────

model WaitlistEntry {
  id           String         @id @default(cuid())
  eventId      String
  userId       String
  ticketTypeId String
  requestedQty Int            @default(1)
  position     Int
  status       WaitlistStatus @default(PENDING)
  /// Set when status transitions to OFFERED
  offerExpiresAt DateTime?
  /// FK to the Reservation created when the offer is made
  reservationId  String?      @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event       Event        @relation(fields: [eventId], references: [id])
  user        User         @relation(fields: [userId], references: [id])
  ticketType  TicketType   @relation(fields: [ticketTypeId], references: [id])
  reservation Reservation? // back-relation via Reservation.waitlistEntryId

  @@unique([userId, ticketTypeId])
  @@index([ticketTypeId, status, position])
  @@index([eventId])
  @@map("waitlist_entries")
}

// ─── Time Slot ────────────────────────────────────────────────────────────────

model TimeSlot {
  id       String           @id @default(cuid())
  eventId  String
  /// Display label, e.g. "26 Dec — 4pm Show"
  label    String
  startsAt DateTime
  endsAt   DateTime
  /// Overall status (ACTIVE / INACTIVE / SOLD_OUT computed per-capacity)
  status   TicketTypeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  capacities TimeSlotCapacity[]
  tickets    TimeSlotTicket[]

  @@index([eventId, status])
  @@map("time_slots")
}

// ─── Time Slot Capacity ───────────────────────────────────────────────────────

/// Per-ticket-type capacity for a time slot.
/// e.g. "26 Dec 4pm show" has 500 VIP spots and 500 Regular spots.
model TimeSlotCapacity {
  id           String     @id @default(cuid())
  timeSlotId   String
  ticketTypeId String
  /// Max spots available for this ticket type at this show
  capacity     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeSlot   TimeSlot   @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  /// One capacity entry per slot+ticketType combination
  @@unique([timeSlotId, ticketTypeId])
  @@index([timeSlotId])
  @@map("time_slot_capacities")
}

// ─── Time Slot Ticket (join) ──────────────────────────────────────────────────

model TimeSlotTicket {
  id           String   @id @default(cuid())
  ticketId     String
  timeSlotId   String
  /// Which ticket type was used for this slot (for per-type capacity tracking)
  ticketTypeId String
  createdAt    DateTime @default(now())

  ticket     Ticket     @relation(fields: [ticketId], references: [id])
  timeSlot   TimeSlot   @relation(fields: [timeSlotId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@unique([ticketId, timeSlotId])
  @@index([timeSlotId, ticketTypeId])
  @@map("time_slot_tickets")
}

// ─── Event Session ────────────────────────────────────────────────────────────

model EventSession {
  id            String               @id @default(cuid())
  eventId       String
  title         String
  description   String?              @db.Text
  facilitator   String?
  startsAt      DateTime
  endsAt        DateTime
  capacity      Int?
  price         Int                  @default(0)
  currency      String               @default("NGN")
  inclusionMode SessionInclusionMode @default(INCLUDED)
  status        TicketTypeStatus     @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event      Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  enrolments SessionEnrolment[]

  @@index([eventId])
  @@map("event_sessions")
}

// ─── Session Enrolment ────────────────────────────────────────────────────────

model SessionEnrolment {
  id        String   @id @default(cuid())
  ticketId  String
  sessionId String
  createdAt DateTime @default(now())

  ticket  Ticket       @relation(fields: [ticketId], references: [id])
  session EventSession @relation(fields: [sessionId], references: [id])

  @@unique([ticketId, sessionId])
  @@index([sessionId])
  @@map("session_enrolments")
}

// ─── Table Seat Assignment ────────────────────────────────────────────────────

/// Per-seat name assignments for table reservations where requiresAssignedSeating = true
model TableSeatAssignment {
  id           String   @id @default(cuid())
  ticketId     String
  ticketTypeId String
  seatNumber   Int
  attendeeName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ticket     Ticket     @relation(fields: [ticketId], references: [id])
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@unique([ticketId, seatNumber])
  @@map("table_seat_assignments")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id         String          @id @default(cuid())
  entityType AuditEntityType
  entityId   String
  action     AuditAction
  oldStatus  String?
  newStatus  String?
  /// userId or "system" for background jobs
  actor      String
  metadata   Json?
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId])
  @@index([actor])
  @@index([createdAt])
  @@map("audit_logs")
}
