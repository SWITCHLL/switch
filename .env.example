# ─── Copy this file to .env.local and fill in values ────────────────────────
# Do NOT commit .env.local — it contains secrets.

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SWITCH

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Runtime URL — transaction pooler (PgBouncer), used by the app
DATABASE_URL=postgresql://user:password@host:6543/db?pgbouncer=true
# Direct URL — bypasses PgBouncer, required for prisma migrate dev/deploy
DIRECT_URL=postgresql://user:password@host:5432/db

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=change_me_to_a_random_32_char_string
AUTH_URL=http://localhost:3000

# ─── Redis (Upstash) ──────────────────────────────────────────────────────────
# Get these from: https://console.upstash.com → your database → REST API
#
# Used by the Next.js app (seat locks, group slot locks, BullMQ queue producer).
# The ioredis client in lib/redis.ts reads REDIS_URL directly.
# For local dev you can use redis://localhost:6379 with a local Redis instance.
REDIS_URL=rediss://default:your_password@your-db.upstash.io:6379

# Used by the BullMQ worker process (workers/index.ts).
# Same value as REDIS_URL — listed separately so the worker can be deployed
# independently (e.g. Railway) with its own env config.
WORKER_REDIS_URL=rediss://default:your_password@your-db.upstash.io:6379

# ─── Google Maps ─────────────────────────────────────────────────────────────
# Needs: Maps JavaScript API + Places API (New) enabled
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here


# ─── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=noreply@switchapp.io

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
# Service role key — NEVER expose this client-side
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Storage bucket name for event images (create this in Supabase → Storage)
SUPABASE_EVENTS_BUCKET=event-images

# ─── Paystack ─────────────────────────────────────────────────────────────────
# Get these from: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# ─── Platform Fee ─────────────────────────────────────────────────────────────
# Default fee percentage charged on every ticket sale (e.g. 4 = 4%)
# Partner organizers can have a custom feePercent set on their Organizer record.
PLATFORM_FEE_PERCENT=4


