    "bullmq": "^6.0.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.16.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.514.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-day-picker": "^9.7.0",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.57.0",
    "resend": "^6.18.1",
